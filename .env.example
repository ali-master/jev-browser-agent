# Base URLs include /v1. Both connections are read before each model request.
# LM Studio: load a decision model for /systemone and a chat model for /chat/completions.
# The chat helper creates a completion checklist for every task and supplies field text.
TYPESAFE_BASE_URL=http://127.0.0.1:1234/v1
TYPESAFE_API_KEY=
TYPESAFE_MODEL=
TEXT_MODEL_BASE_URL=http://127.0.0.1:1234/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL=

# Cloud example: TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TEXT_MODEL_BASE_URL can point to any OpenAI-compatible chat API.
# Saved inspector settings in .jev/settings.json take precedence over these values.
PORT=8766
# Optional: attach an isolated context to a running Chromium CDP endpoint.
# BROWSER_CDP_URL=http://127.0.0.1:9222
