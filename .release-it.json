{
  "$schema": "https://unpkg.com/release-it@21.1.2/schema/release-it.json",
  "git": {
    "commitMessage": "chore(release): v${version}",
    "commit": true,
    "tag": true,
    "push": true
  },
  "npm": {
    "publishPackageManager": "bun",
    "publishPath": ""
  },
  "hooks": {
    "after:bump": "bun install --lockfile-only --ignore-scripts"
  },
  "github": {
    "release": true
  }
}
